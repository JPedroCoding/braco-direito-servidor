# Copie para .env e preencha. O .env NUNCA vai para o Git.
# Cada chave: rode `npm run gerar-chave` e cole o resultado (uma chave diferente para cada linha).

# Chave de criptografia (AES-256). Perdeu a chave = perdeu os dados cifrados. Guarde num cofre de senhas.
CHAVE_CRIPTO=

# Chave de API do coletor (só pode enviar: POST /ingestoes).
CHAVE_API_COLETOR=

# Chave de API do consumidor (só pode consultar: GET /clientes, /multas, /arquivos).
CHAVE_API_CONSUMIDOR=

# Opcionais
PORTA=3001
PASTA_STORAGE=storage
